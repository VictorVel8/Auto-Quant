# Copy to .env (git-ignored). Secrets and machine-specific paths only; behaviour lives in configs/*.yaml.
AF_ENV=                      # dev or prod; prod refuses a dirty git tree
AF_DATA_DIR=                 # root for raw and clean data
AF_STORE_PATH=               # research store SQLite file (Plan 4)
AF_CONFIG_DIR=               # defaults to ./configs
AF_LOG_LEVEL=                # logging verbosity, e.g. INFO
AF_LOG_JSON=                 # true for JSON logs
MASSIVE_API_KEY=             # REST reference data: tickers, splits, dividends (Plan 2)
MASSIVE_S3_ACCESS_KEY_ID=    # flat-file access key id (Plan 2)
MASSIVE_S3_SECRET_ACCESS_KEY= # flat-file secret (Plan 2)
MASSIVE_S3_ENDPOINT=         # flat-file S3 endpoint (Plan 2)
MASSIVE_S3_BUCKET=           # flat-file bucket (Plan 2)
LLM_BASE_URL=                # OpenAI-compatible provider endpoint (Plan 4)
LLM_API_KEY=                 # provider key (Plan 4)
MODAL_TOKEN_ID=              # dev Modal environment token only (Plan 4)
MODAL_TOKEN_SECRET=          # dev Modal environment token only (Plan 4)
AF_MODAL_ENVIRONMENT=        # dev on the mini PC; sealed only on your MacBook (Plan 4)
DISCORD_WEBHOOK_URL=         # loop notifications (Plan 4)
