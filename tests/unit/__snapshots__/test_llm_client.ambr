# name: test_strict_schema_snapshot[ProposalBatch]
  dict({
    '$defs': dict({
      'FactorProposal': dict({
        'additionalProperties': False,
        'properties': dict({
          'condition': dict({
            'anyOf': list([
              dict({
                'maxLength': 200,
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'description': 'Optional boolean DSL expression marking where the effect should be strongest.',
            'title': 'Condition',
          }),
          'expected_sign': dict({
            'description': 'Sign of the IC between the expression and the forward return.',
            'enum': list([
              'positive',
              'negative',
            ]),
            'title': 'Expected Sign',
            'type': 'string',
          }),
          'expression': dict({
            'description': 'DSL expression using only the listed fields and operators.',
            'maxLength': 300,
            'minLength': 3,
            'title': 'Expression',
            'type': 'string',
          }),
          'family': dict({
            'description': 'A family slug from the packet, or a new snake_case slug.',
            'pattern': '^[a-z][a-z0-9_]{2,39}$',
            'title': 'Family',
            'type': 'string',
          }),
          'horizon': dict({
            'description': 'Forward-return label this factor targets.',
            'enum': list([
              'h1',
              'h2',
              'h4',
            ]),
            'title': 'Horizon',
            'type': 'string',
          }),
          'hypothesis': dict({
            'description': 'One falsifiable claim about future returns.',
            'maxLength': 400,
            'minLength': 20,
            'title': 'Hypothesis',
            'type': 'string',
          }),
          'mechanism': dict({
            'description': 'Why the effect exists: who trades, under what pressure.',
            'maxLength': 400,
            'minLength': 20,
            'title': 'Mechanism',
            'type': 'string',
          }),
          'novelty': dict({
            'description': 'What this adds compared with its parents and the pool.',
            'maxLength': 200,
            'title': 'Novelty',
            'type': 'string',
          }),
          'parents': dict({
            'description': 'Ids of pool factors listed in the packet. Never invent ids.',
            'items': dict({
              'type': 'string',
            }),
            'maxItems': 3,
            'title': 'Parents',
            'type': list([
              'array',
              'null',
            ]),
          }),
          'refutations': dict({
            'description': 'Results that would show the hypothesis is wrong.',
            'items': dict({
              '$ref': '#/$defs/RefutationCheck',
            }),
            'maxItems': 4,
            'minItems': 1,
            'title': 'Refutations',
            'type': 'array',
          }),
          'type': dict({
            'description': 'new: no parents. mutate or refine: exactly 1 parent. combine: 2 to 3 parents.',
            'enum': list([
              'new',
              'mutate',
              'refine',
              'combine',
            ]),
            'title': 'Type',
            'type': 'string',
          }),
        }),
        'required': list([
          'type',
          'parents',
          'family',
          'horizon',
          'hypothesis',
          'mechanism',
          'expected_sign',
          'expression',
          'condition',
          'refutations',
          'novelty',
        ]),
        'title': 'FactorProposal',
        'type': 'object',
      }),
      'RefutationCheck': dict({
        'enum': list([
          'subsumed_by_baseline',
          'sign_unstable',
          'not_concentrated_in_condition',
          'weak_at_declared_horizon',
          'cost_killed',
          'correlated_with_parent',
        ]),
        'title': 'RefutationCheck',
        'type': 'string',
      }),
    }),
    'additionalProperties': False,
    'description': 'What the proposer returns. Its JSON Schema is what gets sent.',
    'properties': dict({
      'proposals': dict({
        'items': dict({
          '$ref': '#/$defs/FactorProposal',
        }),
        'maxItems': 16,
        'minItems': 1,
        'title': 'Proposals',
        'type': 'array',
      }),
      'rationale': dict({
        'description': 'How this batch follows the directive and the current beliefs.',
        'maxLength': 600,
        'title': 'Rationale',
        'type': 'string',
      }),
    }),
    'required': list([
      'rationale',
      'proposals',
    ]),
    'title': 'ProposalBatch',
    'type': 'object',
  })
